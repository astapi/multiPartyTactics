        effects: [{ kind: "BUFF", id: "ATK_UP", stat: "atk", amount: 3, duration: 3 }],
        tags: ["buff"],
      },
    ];
  }

  if (jobId === "BLADE") {
    return [
      {
        id: "berserk",
        name: "Berserk",
        type: "buff",
        target: "SELF",
        mpCost: 6,
